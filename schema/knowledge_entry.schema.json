{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "企业知识条目元数据 Schema（八类统一基座 + 来源追踪）",
  "type": "object",
  "required": [
    "entry_id", "knowledge_type", "title", "status",
    "owner_role", "created_at", "source_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^kb-[a-z][a-z0-9-]{2,47}$",
      "description": "知识条目唯一 ID（kb- 前缀）"
    },
    "knowledge_type": {
      "type": "string",
      "enum": [
        "agent_role", "methodology", "case_study", "template",
        "standard", "reference_data", "evidence", "faq"
      ],
      "description": "八类分类法中的类别（必须与 taxonomy 一致）"
    },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"],
      "default": "draft"
    },
    "domain": {
      "type": "string",
      "enum": ["enterprise_management", "customer_operation", "finance",
               "hr", "it_ops", "compliance", "operations", "other"],
      "description": "业务域（可选，按 taxonomy 维度）"
    },
    "owner_role": { "type": "string", "minLength": 2, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "检索标签"
    },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "source_trace": {
      "type": "object",
      "required": ["origin", "provenance"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["internal_project", "public_reference", "customer_material",
                   "synthesized"],
          "description": "来源类型（脱敏合规：customer_material 需授权）"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "reference", "accessed_at"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 3 },
              "accessed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "excerpt": { "type": "string", "minLength": 5 }
            }
          }
        },
        "classification_reason": { "type": "string", "minLength": 5 }
      }
    },
    "type_specific": {
      "type": "object",
      "description": "八类各自的扩展字段（按 knowledge_type 收窄）"
    }
  },
  "if": {
    "properties": { "knowledge_type": { "const": "agent_role" } }
  },
  "then": {
    "properties": {
      "type_specific": {
        "required": ["bot_id", "domain", "escalation"],
        "properties": {
          "bot_id": { "type": "string", "minLength": 2 },
          "domain": { "type": "string", "minLength": 2 },
          "escalation": { "type": "string", "enum": ["human_review", "none"] }
        }
      }
    }
  }
}